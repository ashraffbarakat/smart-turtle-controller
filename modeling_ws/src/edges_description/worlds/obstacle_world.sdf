      <pose>4.5 1.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 1.5</size></box></geometry>
          <material><ambient>0.85 0.35 0.1 1</ambient><diffuse>0.85 0.35 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="maze_wall_4">
      <static>true</static>
      <pose>0.5 4.2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.0 0.2 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.0 0.2 1.5</size></box></geometry>
          <material><ambient>0.1 0.45 0.7 1</ambient><diffuse>0.1 0.45 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

   
    <model name="maze_wall_5">
      <static>true</static>
      <pose>1.5 -4.2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.5 0.2 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.5 0.2 1.5</size></box></geometry>
          <material><ambient>0.1 0.45 0.7 1</ambient><diffuse>0.1 0.45 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

   
    <model name="maze_wall_6">
      <static>true</static>
      <pose>-3.5 2.8 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.0 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 1.5</size></box></geometry>
          <material><ambient>0.85 0.35 0.1 1</ambient><diffuse>0.85 0.35 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  
    <model name="maze_wall_7">
      <static>true</static>
      <pose>-4.2 -2.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.5 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.5 1.5</size></box></geometry>
          <material><ambient>0.85 0.35 0.1 1</ambient><diffuse>0.85 0.35 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>1</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>