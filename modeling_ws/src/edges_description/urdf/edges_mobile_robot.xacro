<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="edges_robot">
  <xacro:include filename="$(find edges_description)/urdf/edges_gazebo.xacro"/>
  <xacro:include filename="$(find edges_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find edges_description)/urdf/lidar.xacro"/>
  <xacro:macro name="mobile_robot">

    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>

    <material name="orange">
      <color rgba="1 0.5 0 1"/>
    </material>

    <link name="base_footprint"/>

    <link name="base_link">

      <visual>
        <geometry>
          <box size="0.7 0.5 0.3"/>
        </geometry>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <material name="black"/>
      </visual>

      <collision>
        <geometry>
          <box size="0.7 0.5 0.3"/>
        </geometry>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
      </collision>

      <inertial>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <mass value="5.0"/>
        <inertia
          ixx="0.14167"
          ixy="0"
          ixz="0"
          iyy="0.24583"
          iyz="0"
          izz="0.35417"/>
      </inertial>

    </link>

    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="base_continuous_link" type="continuous">
      <parent link="base_link"/>
      <child link="continuous_link"/>
      <origin xyz="-0.175 0.25 0" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="continuous_link">

      <visual>
        <geometry>
          <cylinder length="0.08" radius="0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange"/>
      </visual>

      <collision>
        <geometry>
          <cylinder length="0.08" radius="0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
          ixx="0.00277"
          ixy="0"
          ixz="0"
          iyy="0.00277"
          iyz="0"
          izz="0.005"/>
      </inertial>

    </link>

    <joint name="base_continuous_link_2" type="continuous">
      <parent link="base_link"/>
      <child link="continuous_link_2"/>
      <origin xyz="-0.175 -0.25 0" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="continuous_link_2">

      <visual>
        <geometry>
          <cylinder length="0.08" radius="0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange"/>
      </visual>

      <collision>
        <geometry>
          <cylinder length="0.08" radius="0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
          ixx="0.00277"
          ixy="0"
          ixz="0"
          iyy="0.00277"
          iyz="0"
          izz="0.005"/>
      </inertial>

    </link>

    <link name="caster_link">

      <visual>
        <geometry>
          <sphere radius="0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange"/>
      </visual>

      <collision>
        <geometry>
          <sphere radius="0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia
          ixx="0.002"
          ixy="0"
          ixz="0"
          iyy="0.002"
          iyz="0"
          izz="0.002"/>
      </inertial>

    </link>

    <joint name="caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_link"/>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <xacro:mobile_robot/>
  <xacro:lidar_sensor parent="base_link"/>

</robot>
